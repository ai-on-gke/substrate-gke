# Delegate resource deletion to this repository's setup-gcp teardown.
set -o errexit -o nounset -o pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TEARDOWN="${REPO_ROOT}/tools/setup-gcp/teardown.sh"

PROJECT_ID=""
CLUSTER_NAME=""
CLUSTER_LOCATION=""
BUCKET_NAME=""
GCE_REGION=""
ARTIFACT_REGISTRY_REPOSITORY="ate-images"
KEEP_REPOSITORY=true
ASSUME_YES=false

usage() {
  cat >&2 <<'EOF'
Usage: tools/cleanup-gcp --project ID --cluster NAME --location LOCATION --bucket NAME [options]

Deletes the GKE cluster, snapshot bucket, IAM bindings, and monitoring dashboards.
Image repositories are kept unless --delete-repository is given.

Options:
  --region REGION         Repository region (default: derived from --location)
  --repository NAME       Repository created during setup (default: ate-images)
  --delete-repository     Also delete the repository and its images
  --keep-repository       Keep the repository (default); overrides an earlier --delete-repository
  --yes                   Skip the confirmation prompt

The installer prints a command with the values for your installation.
Needs gcloud; deletion is delegated to tools/setup-gcp/teardown.sh.
EOF
  exit 1
}

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --project|--cluster|--location|--bucket|--region|--repository)
      if [[ "$#" -lt 2 || -z "$2" || "$2" == --* ]]; then
        echo "$1 requires a value" >&2
        usage
      fi
      case "$1" in
        --project) PROJECT_ID="$2" ;;
        --cluster) CLUSTER_NAME="$2" ;;
        --location) CLUSTER_LOCATION="$2" ;;
        --bucket) BUCKET_NAME="$2" ;;
        --region) GCE_REGION="$2" ;;
        --repository) ARTIFACT_REGISTRY_REPOSITORY="$2" ;;
      esac
      shift ;;
    --delete-repository) KEEP_REPOSITORY=false ;;
    --keep-repository) KEEP_REPOSITORY=true ;;
    --yes) ASSUME_YES=true ;;
    *) usage ;;
  esac
  shift
done

for var in PROJECT_ID CLUSTER_NAME CLUSTER_LOCATION BUCKET_NAME; do
  if [ -z "${!var}" ]; then
    echo "${var} is required" >&2
    usage
  fi
done
if [[ ! "${ARTIFACT_REGISTRY_REPOSITORY}" =~ ^[a-z]([a-z0-9-]{0,61}[a-z0-9])?$ ]]; then
  echo "invalid repository name: ${ARTIFACT_REGISTRY_REPOSITORY}" >&2
  exit 1
fi
if [ -z "${GCE_REGION}" ]; then
  GCE_REGION="${CLUSTER_LOCATION}"
  if [[ "${CLUSTER_LOCATION}" =~ ^(.+[0-9])-[a-z]$ ]]; then
    GCE_REGION="${BASH_REMATCH[1]}"
  fi
fi
if [ ! -x "${TEARDOWN}" ]; then
  echo "cannot find ${TEARDOWN}; run cleanup-gcp from a substrate-gke checkout" >&2
  exit 1
fi
set -- --all
if ! ${KEEP_REPOSITORY}; then
  set -- "$@" --delete-repository
fi
PROJECT_NUMBER=$(gcloud projects describe "${PROJECT_ID}" --format="value(projectNumber)")
cat <<EOF
About to delete from project ${PROJECT_ID}:
  - the Substrate monitoring dashboards
  - the setup-gcp IAM bindings (project and bucket level)
  - gs://${BUCKET_NAME} and every snapshot in it
  - GKE cluster ${CLUSTER_NAME} in ${CLUSTER_LOCATION}
EOF
if ${KEEP_REPOSITORY}; then
  echo "  Repository ${ARTIFACT_REGISTRY_REPOSITORY} in ${GCE_REGION} will be kept."
else
  echo "  - Artifact Registry repository ${ARTIFACT_REGISTRY_REPOSITORY} in ${GCE_REGION} and its images"
fi
if ! ${ASSUME_YES}; then
  read -r -p "Type 'yes' to continue: " answer
  [ "${answer}" = "yes" ] || { echo "aborted"; exit 1; }
fi

NO_DEV_ENV=1 \
PROJECT_ID="${PROJECT_ID}" \
PROJECT_NUMBER="${PROJECT_NUMBER}" \
CLUSTER_NAME="${CLUSTER_NAME}" \
CLUSTER_LOCATION="${CLUSTER_LOCATION}" \
BUCKET_NAME="${BUCKET_NAME}" \
GCE_REGION="${GCE_REGION}" \
ARTIFACT_REGISTRY_REPOSITORY="${ARTIFACT_REGISTRY_REPOSITORY}" \
NODE_POOL_NAME="" \
  bash "${TEARDOWN}" "$@"

echo "Done. APIs enabled by bootstrap were left enabled (they are free while unused)."
