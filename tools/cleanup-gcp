# cleanup-gcp deletes the GCP resources the installer's provision step
# (`setup-gcp bootstrap`) creates: monitoring dashboards, IAM bindings, the
# snapshot transfer service account, the snapshot and micro-VM asset buckets,
# and the GKE cluster. Image repositories are kept unless --delete-repository
# is given. With --cluster-scoped it deletes only the cluster, its buckets and
# the bindings on them, and keeps what every Substrate cluster in the project
# shares (dashboards, transfer service account, project-level IAM bindings).
#
# It is a thin wrapper: the deletions themselves live in
# tools/setup-gcp/teardown.sh, next to the bootstrap they reverse, so a new
# bootstrap step and its teardown change in the same commit. Both moved here
# from agent-substrate/substrate (agent-substrate/substrate#2304). What stays
# here is the user experience: friendly flags, a confirmation prompt, and
# project-number derivation.
#
# It does NOT remove the Substrate control plane from a cluster you keep; the
# installer's exit summary prints the `ate-setup delete ate-system` command
# for that. Deleting the cluster removes the control plane with it.
#
# The deletions are idempotent, so re-running after a partial failure is safe.

set -o errexit -o nounset -o pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TEARDOWN="${REPO_ROOT}/tools/setup-gcp/teardown.sh"

PROJECT_ID=""
CLUSTER_NAME=""
CLUSTER_LOCATION=""
BUCKET_NAME=""
GCE_REGION=""
ARTIFACT_REGISTRY_REPOSITORY="ate-images"
KEEP_REPOSITORY=true
CLUSTER_SCOPED=false
ASSUME_YES=false

usage() {
  cat >&2 <<'EOF'
Usage: tools/cleanup-gcp --project ID --cluster NAME --location LOCATION --bucket NAME [options]

Deletes the GKE cluster, snapshot and asset buckets, snapshot transfer service account,
IAM bindings, and monitoring dashboards.
Image repositories are kept unless --delete-repository is given.

Options:
  --region REGION         Repository region (default: derived from --location)
  --repository NAME       Repository created during setup (default: ate-images)
  --delete-repository     Also delete the repository and its images
  --keep-repository       Keep the repository (default); overrides an earlier --delete-repository
  --cluster-scoped        Delete only the cluster, its buckets and their bindings; keep the
                          dashboards, transfer service account and project-level IAM bindings
                          that other Substrate clusters in the project share
  --yes                   Skip the confirmation prompt

The installer prints a command with the values for your installation.
Needs gcloud; deletion is delegated to tools/setup-gcp/teardown.sh.
EOF
  exit 1
}

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --project|--cluster|--location|--bucket|--region|--repository)
      if [[ "$#" -lt 2 || -z "$2" || "$2" == --* ]]; then
        echo "$1 requires a value" >&2
        usage
      fi
      case "$1" in
        --project) PROJECT_ID="$2" ;;
        --cluster) CLUSTER_NAME="$2" ;;
        --location) CLUSTER_LOCATION="$2" ;;
        --bucket) BUCKET_NAME="$2" ;;
        --region) GCE_REGION="$2" ;;
        --repository) ARTIFACT_REGISTRY_REPOSITORY="$2" ;;
      esac
      shift ;;
    --delete-repository) KEEP_REPOSITORY=false ;;
    --keep-repository) KEEP_REPOSITORY=true ;;
    --cluster-scoped) CLUSTER_SCOPED=true ;;
    --yes) ASSUME_YES=true ;;
    *) usage ;;
  esac
  shift
done

for var in PROJECT_ID CLUSTER_NAME CLUSTER_LOCATION BUCKET_NAME; do
  if [ -z "${!var}" ]; then
    echo "${var} is required" >&2
    usage
  fi
done
if [[ ! "${ARTIFACT_REGISTRY_REPOSITORY}" =~ ^[a-z]([a-z0-9-]{0,61}[a-z0-9])?$ ]]; then
  echo "invalid repository name: ${ARTIFACT_REGISTRY_REPOSITORY}" >&2
  exit 1
fi
if [ -z "${GCE_REGION}" ]; then
  GCE_REGION="${CLUSTER_LOCATION}"
  if [[ "${CLUSTER_LOCATION}" =~ ^(.+[0-9])-[a-z]$ ]]; then
    GCE_REGION="${BASH_REMATCH[1]}"
  fi
fi
if [ ! -x "${TEARDOWN}" ]; then
  echo "cannot find ${TEARDOWN}; run cleanup-gcp from a substrate-gke checkout" >&2
  exit 1
fi
if ${CLUSTER_SCOPED}; then
  set -- --cluster-scoped
else
  set -- --all
fi
if ! ${KEEP_REPOSITORY}; then
  set -- "$@" --delete-repository
fi
PROJECT_NUMBER=$(gcloud projects describe "${PROJECT_ID}" --format="value(projectNumber)")
echo "About to delete from project ${PROJECT_ID}:"
if ${CLUSTER_SCOPED}; then
  echo "  - the setup-gcp IAM bindings on the two buckets below"
else
  cat <<EOF
  - the Substrate monitoring dashboards
  - the setup-gcp IAM bindings (project and bucket level)
  - the snapshot transfer service account
EOF
fi
cat <<EOF
  - gs://${BUCKET_NAME} and every snapshot in it
  - gs://${BUCKET_NAME}-assets and the micro-VM assets in it
  - GKE cluster ${CLUSTER_NAME} in ${CLUSTER_LOCATION}
EOF
if ${CLUSTER_SCOPED}; then
  echo "  The dashboards, the snapshot transfer service account and the project-level IAM bindings will be kept."
fi
if ${KEEP_REPOSITORY}; then
  echo "  Image repositories will be kept."
else
  echo "  - Artifact Registry repository ${ARTIFACT_REGISTRY_REPOSITORY} in ${GCE_REGION} and its images"
fi
if ! ${ASSUME_YES}; then
  read -r -p "Type 'yes' to continue: " answer
  [ "${answer}" = "yes" ] || { echo "aborted"; exit 1; }
fi

# NODE_POOL_NAME stays empty on purpose: deleting the cluster removes its
# pools, and teardown.sh skips the separate pool step without it. NO_DEV_ENV
# keeps teardown.sh from sourcing a .ate-dev-env.sh in the working directory,
# which could name a different project or cluster than the flags above.
NO_DEV_ENV=1 \
PROJECT_ID="${PROJECT_ID}" \
PROJECT_NUMBER="${PROJECT_NUMBER}" \
CLUSTER_NAME="${CLUSTER_NAME}" \
CLUSTER_LOCATION="${CLUSTER_LOCATION}" \
BUCKET_NAME="${BUCKET_NAME}" \
GCE_REGION="${GCE_REGION}" \
ARTIFACT_REGISTRY_REPOSITORY="${ARTIFACT_REGISTRY_REPOSITORY}" \
NODE_POOL_NAME="" \
  bash "${TEARDOWN}" "$@"

echo "Done. APIs enabled by bootstrap were left enabled (they are free while unused)."
