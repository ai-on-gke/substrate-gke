# cleanup-gcp deletes the GCP resources the installer's provision step
# (upstream `setup-gcp bootstrap`) creates: monitoring dashboards, IAM
# bindings, the snapshot bucket, and the GKE cluster.
#
# It is a thin wrapper: the deletions themselves live in upstream's
# hack/teardown.sh, fetched at the same pinned commit the installer builds
# from — the teardown that matches what that bootstrap actually created.
# Keeping the resource knowledge upstream means a new bootstrap step gets its
# teardown in the same repo, and this wrapper inherits it at every pin bump
# instead of drifting. What stays here is the user experience: friendly
# flags, a confirmation prompt, and project-number derivation.
#
# It does NOT remove the Substrate control plane from a cluster you keep; the
# installer's exit summary prints the `ate-setup delete ate-system` command
# for that. Deleting the cluster removes the control plane with it.
#
# Upstream's deletions are idempotent, so re-running after a partial failure
# is safe.

set -o errexit -o nounset -o pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SNAPSHOT_GO="${REPO_ROOT}/installer/internal/snapshot/snapshot.go"

# The pin is read from the installer source rather than copied here, so the
# wrapper can never tear down with a different revision than the one the
# installer provisioned with.
pin_commit() {
  sed -n 's/^\tCommit = "\([0-9a-f]\{40\}\)"$/\1/p' "${SNAPSHOT_GO}"
}
module_path() {
  sed -n 's/^\tModulePath = "\(.*\)"$/\1/p' "${SNAPSHOT_GO}"
}

PROJECT_ID=""
CLUSTER_NAME=""
CLUSTER_LOCATION=""
BUCKET_NAME=""
ASSUME_YES="false"

usage() {
  cat >&2 <<'EOF'
Usage: tools/cleanup-gcp --project ID --cluster NAME --location ZONE --bucket NAME [--yes]

Deletes everything the installer's provision step created in GCP:
the Substrate monitoring dashboards, the IAM bindings it granted, the
snapshot bucket and its contents, and the GKE cluster (and, with it, the
Substrate control plane).

The values are printed by the installer's exit summary; they are the answers
you gave the wizard. --yes skips the confirmation prompt. Needs gcloud and
git (the deletions run from a temporary checkout of the pinned substrate
revision).
EOF
  exit 1
}

while [[ "$#" -gt 0 ]]; do
  case $1 in
    --project) PROJECT_ID="$2"; shift ;;
    --cluster) CLUSTER_NAME="$2"; shift ;;
    --location) CLUSTER_LOCATION="$2"; shift ;;
    --bucket) BUCKET_NAME="$2"; shift ;;
    --yes) ASSUME_YES="true" ;;
    --print-pin) pin_commit; exit 0 ;;
    *) usage ;;
  esac
  shift
done

for var in PROJECT_ID CLUSTER_NAME CLUSTER_LOCATION BUCKET_NAME; do
  if [ -z "${!var}" ]; then
    echo "missing ${var}; see --help" >&2
    usage
  fi
done

COMMIT="$(pin_commit)"
if [ -z "${COMMIT}" ]; then
  echo "could not read the substrate pin from ${SNAPSHOT_GO}" >&2
  exit 1
fi
REPO_URL="https://$(module_path).git"

# The IAM principals are keyed to the project number, not the ID.
PROJECT_NUMBER=$(gcloud projects describe "${PROJECT_ID}" --format="value(projectNumber)")

cat <<EOF
About to delete from project ${PROJECT_ID}:
  - the Substrate monitoring dashboards
  - the setup-gcp IAM bindings (project and bucket level)
  - gs://${BUCKET_NAME} and every snapshot in it
  - GKE cluster ${CLUSTER_NAME} in ${CLUSTER_LOCATION}
EOF
if [ "${ASSUME_YES}" != "true" ]; then
  read -r -p "Type 'yes' to continue: " answer
  [ "${answer}" = "yes" ] || { echo "aborted"; exit 1; }
fi

echo "Fetching substrate@${COMMIT:0:12} for its teardown script..."
d=$(mktemp -d)
trap 'rm -rf "$d"' EXIT
git -C "$d" init -q
git -C "$d" fetch -q --depth 1 "${REPO_URL}" "${COMMIT}"
git -C "$d" checkout -q FETCH_HEAD
cd "$d"

# NODE_POOL_NAME stays unset on purpose: deleting the cluster removes its
# pools, and teardown.sh skips the separate pool step without it.
PROJECT_ID="${PROJECT_ID}" \
PROJECT_NUMBER="${PROJECT_NUMBER}" \
CLUSTER_NAME="${CLUSTER_NAME}" \
CLUSTER_LOCATION="${CLUSTER_LOCATION}" \
BUCKET_NAME="${BUCKET_NAME}" \
  ./hack/teardown.sh --all

echo "Done. APIs enabled by bootstrap were left enabled (they are free while unused)."
