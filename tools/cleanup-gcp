# cleanup-gcp deletes the GCP resources the installer's provision step
# (upstream `setup-gcp bootstrap`) creates: monitoring dashboards, IAM
# bindings, the snapshot bucket, and the GKE cluster — in the reverse of the
# order bootstrap creates them. It needs only gcloud, so it works long after
# the pinned substrate checkout the installer fetched is gone.
#
# It does NOT remove the Substrate control plane from a cluster you keep; the
# installer's exit summary prints the `ate-setup delete ate-system` command
# for that. Deleting the cluster removes the control plane with it.
#
# Every deletion is idempotent (`|| true` on not-found), so re-running after
# a partial failure is safe.

set -o errexit -o nounset -o pipefail

PROJECT_ID=""
CLUSTER_NAME=""
CLUSTER_LOCATION=""
BUCKET_NAME=""
ASSUME_YES="false"

usage() {
  cat >&2 <<'EOF'
Usage: tools/cleanup-gcp --project ID --cluster NAME --location ZONE --bucket NAME [--yes]

Deletes everything the installer's provision step created in GCP:
  1. The Substrate monitoring dashboards
  2. The bucket- and project-level IAM bindings it granted
  3. The snapshot bucket and its contents
  4. The GKE cluster (and, with it, the Substrate control plane)

The values are printed by the installer's exit summary; they are the answers
you gave the wizard. --yes skips the confirmation prompt.
EOF
  exit 1
}

while [[ "$#" -gt 0 ]]; do
  case $1 in
    --project) PROJECT_ID="$2"; shift ;;
    --cluster) CLUSTER_NAME="$2"; shift ;;
    --location) CLUSTER_LOCATION="$2"; shift ;;
    --bucket) BUCKET_NAME="$2"; shift ;;
    --yes) ASSUME_YES="true" ;;
    *) usage ;;
  esac
  shift
done

for var in PROJECT_ID CLUSTER_NAME CLUSTER_LOCATION BUCKET_NAME; do
  if [ -z "${!var}" ]; then
    echo "missing ${var}; see --help" >&2
    usage
  fi
done

# The IAM principals are keyed to the project number, not the ID.
PROJECT_NUMBER=$(gcloud projects describe "${PROJECT_ID}" --format="value(projectNumber)")

cat <<EOF
About to delete from project ${PROJECT_ID}:
  - the Substrate monitoring dashboards
  - the setup-gcp IAM bindings (project and bucket level)
  - gs://${BUCKET_NAME} and every snapshot in it
  - GKE cluster ${CLUSTER_NAME} in ${CLUSTER_LOCATION}
EOF
if [ "${ASSUME_YES}" != "true" ]; then
  read -r -p "Type 'yes' to continue: " answer
  [ "${answer}" = "yes" ] || { echo "aborted"; exit 1; }
fi

ATELET="principal://iam.googleapis.com/projects/${PROJECT_NUMBER}/locations/global/workloadIdentityPools/${PROJECT_ID}.svc.id.goog/subject/ns/ate-system/sa/atelet"
NODE_SA="serviceAccount:${PROJECT_NUMBER}-compute@developer.gserviceaccount.com"

echo "Deleting Substrate monitoring dashboards..."
# Matched by the display names in upstream tools/setup-gcp/dashboards/.
declare -a DASHBOARD_NAMES=(
  "Substrate Snapshot Size & QPS"
  "Substrate Routing & E2E Latency"
  "Substrate gRPC Server — latency / QPS / errors"
)
for display_name in "${DASHBOARD_NAMES[@]}"; do
  for dashboard in $(gcloud monitoring dashboards list \
      --project="${PROJECT_ID}" \
      --filter="displayName=\"${display_name}\"" \
      --format="value(name)" 2>/dev/null); do
    gcloud monitoring dashboards delete "${dashboard}" \
      --project="${PROJECT_ID}" --quiet || true
  done
done

echo "Removing bucket-level IAM bindings..."
for role in roles/storage.objectAdmin roles/storage.bucketViewer; do
  gcloud storage buckets remove-iam-policy-binding "gs://${BUCKET_NAME}" \
    --member="${ATELET}" --role="${role}" --quiet 2>/dev/null || true
done

echo "Removing project-level IAM bindings..."
for role in roles/storage.objectAdmin roles/artifactregistry.reader; do
  gcloud projects remove-iam-policy-binding "${PROJECT_ID}" \
    --member="${ATELET}" --role="${role}" --condition=None --quiet >/dev/null 2>&1 || true
done
for role in roles/storage.objectViewer roles/artifactregistry.reader; do
  gcloud projects remove-iam-policy-binding "${PROJECT_ID}" \
    --member="${NODE_SA}" --role="${role}" --condition=None --quiet >/dev/null 2>&1 || true
done

echo "Deleting snapshot bucket gs://${BUCKET_NAME}..."
gcloud storage rm --recursive "gs://${BUCKET_NAME}/**" --project="${PROJECT_ID}" --quiet 2>/dev/null || true
gcloud storage buckets delete "gs://${BUCKET_NAME}" --project="${PROJECT_ID}" --quiet || true

echo "Deleting GKE cluster ${CLUSTER_NAME}..."
gcloud container clusters delete "${CLUSTER_NAME}" \
  --location="${CLUSTER_LOCATION}" --project="${PROJECT_ID}" --quiet || true

echo "Done. APIs enabled by bootstrap were left enabled (they are free while unused)."
